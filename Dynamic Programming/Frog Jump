// memoization
fun frogJump(nums:IntArray,i:Int,dp:Array<Int>):Int{
    val n = nums.size
    if(i == n-1){
        return 0
    }
    
    if(dp[i] != -1){
        return dp[i]
    }
    
    val oneJump = frogJump(nums,i+1,dp) + kotlin.math.abs(nums[i] - nums[i + 1])
    val twoJump = if(i +2 < n){
    	frogJump(nums,i+2,dp) + kotlin.math.abs(nums[i] - nums[i + 2])
    }else {
        Int.MAX_VALUE
    }
    
    dp[i] = minOf(oneJump,twoJump)
    
    return dp[i]
}
