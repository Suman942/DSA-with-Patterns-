1. Merge Sort

class Solution {
    fun sortArray(nums: IntArray): IntArray {
        ms(nums,0,nums.size - 1)
        return nums
    }

    fun ms(arr:IntArray,left:Int,right:Int){
        if(left >= right) return

        val mid = left + (right - left)/2

        // left sub array
        ms(arr,left,mid)

        // right subarray
        ms(arr,mid+1,right)

        // merge
        merge(arr,left,mid,right)
    }

    fun merge(arr:IntArray,left:Int,mid:Int,right:Int){
        val temp = mutableListOf<Int>()
        var i = left
        var j = mid + 1

        while(i<= mid && j<= right){
            if(arr[i] < arr[j]){
                temp.add(arr[i])
                i++
            }else{
                temp.add(arr[j])
                j++
            }
        }

        // check for i until the end
        while(i <= mid){
             temp.add(arr[i])
                i++
        }

        // check for j until the end
        while(j <= right){
             temp.add(arr[j])
                j++
        }

        // copy the temp array into the 
        for(k in temp.indices){
            arr[left + k] = temp[k]
        }
    }
}
