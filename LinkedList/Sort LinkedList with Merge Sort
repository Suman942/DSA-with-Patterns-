fun ms(node:Node?) : Node?{
    if(node == null || node.next == null) return node
    
    
    // find the middle
    var fast : Node?= node
    var slow : Node?= node
    var prev : Node? = null
    while(fast != null && fast.next != null ){
        prev = slow
        slow = slow?.next
        fast = fast?.next?.next
    }
    
    
    // split 
    prev?.next = null
    
    var left = node
    var right = slow
    
    // left 
   val lMs = ms(left)
    
    //right
   val rMs = ms(right)
    
    // merge
   val result = merge(lMs,rMs)
   var temp = result
   while(temp != null){
       println(temp.data)
       temp = temp.next
   }
   
   return result
}

fun merge(left:Node?,right:Node?) : Node?{
    val dummy = Node(0)
    var current = dummy
    var l = left
    var r = right
    while(l != null && r != null){
        if(l.data <= r.data){
            current.next = l
            l = l.next
        }else{
            current.next = r
            r = r.next
        }
    	current = current.next!!
    }
    
    // remaining left
    if(l != null){
        current.next = l
    }
    
     // remaining right
    if(r != null){
        current.next = r
    }
    
    return dummy.next
}

class Node(val data :Int){
    var next:Node?= null
}
