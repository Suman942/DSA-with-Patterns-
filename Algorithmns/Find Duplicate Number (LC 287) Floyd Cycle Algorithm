fun main() {
 	val nums = intArrayOf(2,1,6,5,1,4,3)
    // fast and slow pointer untill both pointers are same
    var slow = 0
    var fast = 0
    
    do{
        slow = nums[slow]
        fast = nums[nums[fast]]
        println("slow:$slow  fast:$fast")
    }while(slow != fast)
    println()
    println("------")
    println()

    slow = 0
    while(slow != fast){
        slow = nums[slow]
        fast = nums[fast]
        println("slow:$slow  fast:$fast")
        
    }
    
    println("result:$slow")
}
