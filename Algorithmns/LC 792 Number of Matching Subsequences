class Solution {
    fun numMatchingSubseq(s: String, words: Array<String>): Int {
        var count = 0
        if(s.isEmpty()) return count
        // store the index of each character
        val map = mutableMapOf<Char, MutableList<Int>>()
        for(i in 0 until s.length){
            map.getOrPut(s[i]){
                mutableListOf()
            }.add(i)
        }
        // iterate each element
        for(str in words){
            var isSequence = true
            var lastIndex = -1
            // iterate each char of the string
            for(i in 0 until str.length){
                // if char contains in the map
                if(map.containsKey(str[i])){ 
                    // fetch the value from the map
                    val list = map[str[i]]

                    if(list == null || list.isEmpty()){
                        isSequence = false
                        break
                    }

                // binary search to find the first index whose value is greater than last index
                var left = 0
                var right = list.size - 1

                while(left <= right){
                    val mid = left + (right - left)/2
                    if(list[mid] > lastIndex){
                        right = mid - 1
                    }else{
                        left = mid +1
                    }
                }
                // if first index is equals to the size of the array its invalid
                if(left ==list.size){
                    isSequence = false
                    break
                }

                lastIndex = list[left]

                }else{
                    // if char doesnt contain
                     isSequence = false
                     break
                }
            }

            if( isSequence ){
                count++
            }
        }
      

        return count
    }

}
